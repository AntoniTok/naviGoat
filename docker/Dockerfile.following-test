# Keep Enid's original image definition unchanged; add explicit ROS dependencies
# for the standalone console-only following runner and depth registration.
FROM navigoat:people-dev

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-depth-image-proc \
    ros-jazzy-cv-bridge \
    ros-jazzy-message-filters \
    ros-jazzy-rclpy \
    ros-jazzy-std-msgs \
    ros-jazzy-std-srvs \
    && rm -rf /var/lib/apt/lists/*
